#include <winver.h>

#define CMS2_FILE_VERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
#define CMS2_FILE_VERSION_TEXT "@PROJECT_VERSION@.0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION CMS2_FILE_VERSION
 PRODUCTVERSION CMS2_FILE_VERSION
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "CKW25\0"
            VALUE "FileDescription", "Moon Scaler NG SKSE Plugin\0"
            VALUE "FileVersion", CMS2_FILE_VERSION_TEXT "\0"
            VALUE "InternalName", "MoonScalerNG\0"
            VALUE "LegalCopyright", "Copyright (c) CKW25\0"
            VALUE "OriginalFilename", "MoonScalerNG.dll\0"
            VALUE "ProductName", "Moon Scaler NG\0"
            VALUE "ProductVersion", CMS2_FILE_VERSION_TEXT "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
